---
import type { ProcessStepData } from "@/core/ProcessSteepData";

interface Props extends ProcessStepData {
    number: number;
    index?: number;
}

const { icon, title, description, number, index = 0 } = Astro.props;
const formattedNumber = String(number).padStart(2, '0');
---

<div
    data-reveal="up"
    style={`--i: ${index + 1}`}
    class="step-card relative w-full border border-white/10 rounded-xl bg-background/90 backdrop-blur p-5 space-y-5 transition-[border-color,translate] duration-300 hover:border-primary/40 hover:-translate-y-1"
>

    <!-- Icon & Number -->
    <div class="flex items-center justify-between gap-x-3">

        <!-- Icon -->
        <div class="step-icon size-12 rounded-full bg-primary/10 flex items-center justify-center">
            <img src={icon} alt={title} class="size-7" />
        </div>
        
        <!-- Number -->
        <div class="text-white/20 font-bold text-4xl">{formattedNumber}</div>
    </div>

    <!-- Title & Description -->
    <div class="space-y-3 text-start">
        <h4 class="text-lg font-medium">{title}</h4>
        <p class="text-neutral-300 text-sm">{description}</p>
    </div>
</div>
