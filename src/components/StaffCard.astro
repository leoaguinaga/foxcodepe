---
import type { StaffMember } from "@/core/StaffData";

interface Props extends StaffMember {
    index?: number;
}

const { name, role, role2, imageUrl, href, index = 0 } = Astro.props;
---

<!-- Staff Card -->
<a
    href={href}
    data-reveal="scale"
    style={`--i: ${index + 1}`}
    class="staff-card group relative flex flex-col items-center"
>
    <div class="relative w-68 h-68 flex items-center justify-center">
        <svg
            class="staff-ring absolute w-full h-full animate-spin-slow"
            viewBox="0 0 200 200"
        >
            <path
                id={`circlePath-${name.replace(/\s+/g, '-')}`}
                d="M 100, 100 m -80, 0 a 80,80 0 1,1 160,0 a 80,80 0 1,1 -160,0"
                fill="transparent"></path>
            <text
                class="fill-white font-medium text-xs tracking-[0.2em] uppercase"
            >
                <textPath
                    xlink:href={`#circlePath-${name.replace(/\s+/g, '-')}`}
                    text-anchor="center"
                >
                    {role} 
                </textPath>
            </text>
        </svg>

        <div
            class="w-48 h-48 rounded-full overflow-hidden bg-white/5 ring-1 ring-white/10 transition-[box-shadow] duration-500 group-hover:ring-primary/60"
        >
            <img
                src={imageUrl}
                alt={name}
                class="w-full h-full object-cover grayscale-[35%] transition-[filter,scale] duration-700 group-hover:grayscale-0 group-hover:scale-108"
            />
        </div>
    </div>

    <div class="text-center -mt-5">
        <h4 class="text-white px-5 py-2 rounded-full bg-white/5 w-fit mx-auto">{name}</h4>
        {role2 && <p class="mt-2 text-xs text-white/50">{role2}</p>}
    </div>
    
</a>
