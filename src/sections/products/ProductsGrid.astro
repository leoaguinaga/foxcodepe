---
import { Image } from "astro:assets";
import { products } from "@/core/ProductsData";
import { productMockups, productTransitionName } from "@/core/ProductMockups";
---

<section id="productos" class="w-full max-w-6xl mx-auto pb-24 max-xl:px-5">
    {
        products.map((product) => {
            const activeModule = product.modules[0];

            return (
                <article class="grid gap-8 border-t border-white/10 py-12 md:py-14 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-14 lg:items-start">
                    <div id={product.id} class="scroll-mt-28 flex flex-col gap-4">
                        <div class="flex items-end gap-4">
                            {productMockups[product.id] && (
                                <Image
                                    src={productMockups[product.id]}
                                    alt=""
                                    width={160}
                                    class="h-auto w-16 md:w-20 drop-shadow-[0_16px_20px_rgb(0_0_0/0.5)]"
                                    style={`view-transition-name:${productTransitionName(product.id)}`}
                                />
                            )}
                            <span class="mb-1 rounded-full bg-primary px-3 py-2 text-xs font-semibold uppercase leading-none tracking-wider">
                                {product.category}
                            </span>
                        </div>
                        <h2 class="font-display text-3xl md:text-4xl font-semibold leading-[1.05] tracking-[-0.03em] text-balance">
                            {product.title}
                        </h2>
                        <p class="text-neutral-300 max-md:text-sm">{product.description}</p>

                        <!-- Para quién: antes era una tarjeta con foto; ahora es texto -->
                        <div class="mt-2 border-l-2 border-primary/60 pl-4">
                            <p class="text-sm font-semibold text-white">{product.secondaryFeature.title}</p>
                            <p class="mt-1 text-sm text-neutral-400">{product.secondaryFeature.description}</p>
                        </div>
                    </div>

                    <div
                        class="product-module-carousel overflow-hidden rounded-2xl border border-white/10 bg-white/5"
                        data-product-carousel
                    >
                        <!-- Preview -->
                        <div class="flex h-64 md:h-80 items-center justify-center bg-white/5 p-4">
                            <img
                                src={activeModule.image.src}
                                alt={activeModule.title}
                                class="max-h-full max-w-full rounded-lg object-contain transition-opacity duration-300"
                                data-module-preview-image
                            />
                        </div>

                        <div class="flex flex-col gap-4 p-5 sm:flex-row sm:items-start sm:justify-between">
                            <div class="space-y-1.5 sm:max-w-sm">
                                <h3 class="product-module-title text-lg text-white" data-module-active-title>
                                    {activeModule.title}
                                </h3>
                                <p class="product-module-description text-sm text-neutral-300" data-module-active-description>
                                    {activeModule.description}
                                </p>
                            </div>

                            <div class="flex shrink-0 gap-2">
                                {product.modules.map((module, moduleIndex) => (
                                    <button
                                        type="button"
                                        class={`product-module-trigger flex size-10 items-center justify-center rounded-md border bg-white/5 transition hover:border-primary/70 ${moduleIndex === 0 ? "border-primary" : "border-white/10"}`}
                                        aria-label={`Ver módulo ${module.title}`}
                                        data-module-trigger
                                        data-module-index={moduleIndex}
                                        data-module-title={module.title}
                                        data-module-description={module.description}
                                        data-module-image={module.image.src}
                                    >
                                        <img src={module.icon} alt="" class="size-5 object-contain opacity-80" loading="lazy" />
                                    </button>
                                ))}
                            </div>
                        </div>
                    </div>
                </article>
            );
        })
    }
</section>

<script>
    const carousels = document.querySelectorAll('[data-product-carousel]');

    carousels.forEach((carousel) => {
        const image = carousel.querySelector('[data-module-preview-image]') as HTMLImageElement | null;
        const title = carousel.querySelector('[data-module-active-title]') as HTMLElement | null;
        const description = carousel.querySelector('[data-module-active-description]') as HTMLElement | null;
        const triggers = Array.from(
            carousel.querySelectorAll('[data-module-trigger]'),
        ) as HTMLButtonElement[];
        let activeIndex = 0;
        let intervalId: number | undefined;

        function setActiveModule(index: number) {
            const trigger = triggers[index];

            if (!trigger || !image || !title || !description) {
                return;
            }

            activeIndex = index;
            image.classList.add('opacity-0');

            window.setTimeout(() => {
                image.src = trigger.dataset.moduleImage || image.src;
                image.alt = trigger.dataset.moduleTitle || '';
                title.textContent = trigger.dataset.moduleTitle || '';
                description.textContent = trigger.dataset.moduleDescription || '';
                image.classList.remove('opacity-0');
            }, 150);

            triggers.forEach((button, buttonIndex) => {
                button.classList.toggle('border-primary', buttonIndex === activeIndex);
                button.classList.toggle('border-white/10', buttonIndex !== activeIndex);
            });
        }

        function startAutoPlay() {
            window.clearInterval(intervalId);
            intervalId = window.setInterval(() => {
                setActiveModule((activeIndex + 1) % triggers.length);
            }, 5500);
        }

        triggers.forEach((trigger, index) => {
            trigger.addEventListener('click', () => {
                setActiveModule(index);
                startAutoPlay();
            });
        });

        if (triggers.length > 1) {
            startAutoPlay();
        }
    });
</script>
