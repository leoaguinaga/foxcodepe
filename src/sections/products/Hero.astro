---
import { products } from "@/core/ProductsData";

// "Escapify: Tu tienda online…" → "Escapify"
const names = products.map((product) => ({
    id: product.id,
    name: product.title.split(":")[0],
    category: product.category,
}));
---

<section class="w-full max-w-6xl mx-auto pt-24 pb-12 md:pt-32 md:pb-16 max-xl:px-5">
    <p class="text-xs font-semibold uppercase tracking-[0.2em] text-primary">
        Productos
    </p>
    <div class="mt-5 grid gap-6 lg:grid-cols-[1fr_auto] lg:items-end">
        <h1
            class="font-display max-w-3xl text-[clamp(2.25rem,5vw,4rem)] font-semibold leading-[0.98] tracking-[-0.035em] text-balance"
        >
            Las <span class="text-primary">herramientas</span> que tu empresa necesita.
        </h1>
        <p class="max-w-md text-neutral-300">
            Soluciones listas para usar que optimizan procesos, mejoran la
            experiencia de tus clientes y escalan contigo.
        </p>
    </div>

    <ul class="mt-10 flex flex-wrap gap-2">
        {
            names.map((product) => (
                <li>
                    <a
                        href={`#${product.id}`}
                        class="flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-3.5 py-2 text-sm text-neutral-300 transition hover:border-white/25 hover:text-white"
                    >
                        {product.name}
                        <span class="text-[10px] uppercase tracking-wider text-neutral-500">
                            {product.category}
                        </span>
                    </a>
                </li>
            ))
        }
    </ul>
</section>
