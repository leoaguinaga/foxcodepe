---
import { Image } from "astro:assets";
import MockupFoxRooms from "@/assets/images/mockup-foxrooms.png";
import FoxRoomsDashboard from "@/assets/images/modules/foxrooms/dashboard.png";

// Las tres capas de un sistema real (FoxRooms), apiladas: backend al fondo,
// panel web al medio y app al frente. Mismo equipo para las tres.
const requests = [
    ["POST", "/reservas/:id/check-in", "201", "38 ms"],
    ["GET", "/habitaciones?libre=hoy", "200", "12 ms"],
    ["POST", "/facturas/sunat", "201", "210 ms"],
    ["POST", "/pagos/mercadopago", "201", "96 ms"],
];
---

<section class="services-hero relative overflow-hidden pt-24 pb-14 md:pt-32 md:pb-20 max-xl:px-5">
    <div class="w-full max-w-6xl mx-auto grid gap-14 lg:grid-cols-[0.95fr_1.05fr] lg:items-center">
        <div class="relative z-10">
            <h1 class="font-display text-[clamp(3rem,6.4vw,5.75rem)] leading-[0.92] text-balance">
                Tu software completo, hecho por <span class="text-primary">un solo equipo.</span>
            </h1>
            <p class="mt-7 max-w-[30rem] text-lg leading-relaxed text-neutral-300">
                Diseñamos, programamos y desplegamos la web, el backend y la app.
                Una persona responsable de tu proyecto y entregas cada semana en
                un staging que puedes usar.
            </p>
            <div class="mt-9 flex flex-wrap gap-2.5">
                <a
                    href="#formas-de-trabajo"
                    class="group inline-flex items-center gap-2 bg-primary text-white font-medium px-5 py-3 rounded-full shadow-[0_6px_20px_-6px_rgb(238_77_49/0.6)] hover:bg-primary-dark active:scale-[0.96] transition"
                >
                    Ver planes
                    <svg class="size-4 transition-transform duration-300 group-hover:translate-y-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M6 13l6 6 6-6" /></svg>
                </a>
                <a
                    href="/#agendar"
                    class="inline-flex items-center bg-white/5 text-white font-medium px-5 py-3 rounded-full hover:bg-white/10 active:scale-[0.96] transition"
                >
                    Agendar una reunión
                </a>
            </div>
        </div>

        <!-- Capas apiladas -->
        <figure class="stage" data-stage aria-label="FoxRooms por capas: API al fondo, panel web al medio y app móvil al frente">
            <div class="stack" data-stack>
                <div class="layer layer-api">
                    <div class="api-card">
                        <p class="api-head"><span>api.foxrooms</span><span class="ok">● en línea</span></p>
                        <ul>
                            {requests.map(([method, path, status, time]) => (
                                <li>
                                    <b class:list={["method", method === "GET" ? "get" : "post"]}>{method}</b>
                                    <span class="path">{path}</span>
                                    <span class="status">{status}</span>
                                    <span class="time">{time}</span>
                                </li>
                            ))}
                        </ul>
                        <p class="api-foot">✓ 128 tests · deploy a producción en 42 s</p>
                    </div>
                    <span class="tag tag-api"><i></i>Backend y APIs</span>
                </div>

                <div class="layer layer-web">
                    <Image
                        src={FoxRoomsDashboard}
                        alt=""
                        width={1100}
                        class="web-shot"
                        loading="eager"
                    />
                    <span class="tag tag-web"><i></i>Web</span>
                </div>

                <div class="layer layer-mobile">
                    <Image
                        src={MockupFoxRooms}
                        alt=""
                        width={460}
                        class="phone"
                        loading="eager"
                    />
                    <span class="tag tag-mobile"><i></i>Mobile</span>
                </div>
            </div>
            <figcaption class="caption">FoxRooms, construido de punta a punta por FoxCode</figcaption>
        </figure>
    </div>
</section>

<style>
    .services-hero {
        --ease: cubic-bezier(0.16, 1, 0.3, 1);
    }

    .services-hero::before {
        content: "";
        position: absolute;
        right: -10%;
        top: 10%;
        width: 60%;
        aspect-ratio: 1;
        background: radial-gradient(closest-side, rgb(238 77 49 / 0.16), transparent);
        filter: blur(30px);
        pointer-events: none;
    }

    .stage {
        position: relative;
        margin: 0;
        perspective: 1800px;
        max-width: 100%;
    }

    .stack {
        --rx: 6deg;
        --ry: -14deg;
        position: relative;
        aspect-ratio: 1 / 0.9;
        transform-style: preserve-3d;
        transform: rotateX(var(--rx)) rotateY(var(--ry));
        transition: transform 0.8s var(--ease);
    }

    .layer {
        position: absolute;
        transform-style: preserve-3d;
        animation-duration: 1.1s;
        animation-timing-function: var(--ease);
        animation-fill-mode: both;
    }

    /* Al cargar, las capas parten juntas detrás del panel y se separan. */
    .layer-api {
        left: 0;
        bottom: 5%;
        width: 62%;
        transform: translateZ(-60px);
        animation-name: settle-api;
        animation-delay: 0.15s;
    }

    @keyframes settle-api {
        from {
            transform: translate3d(12%, -40%, -60px);
        }
    }

    .layer-web {
        left: 13%;
        top: 4%;
        width: 82%;
        transform: translateZ(0);
        animation: none;
    }

    .layer-mobile {
        right: -3%;
        bottom: 0;
        width: 33%;
        transform: translateZ(70px);
        animation-name: settle-mobile;
        animation-delay: 0.25s;
    }

    @keyframes settle-mobile {
        from {
            transform: translate3d(-35%, -30%, 70px);
        }
    }

    .api-card {
        border: 1px solid rgb(255 255 255 / 0.12);
        border-radius: 14px;
        background: #111113;
        padding: 0.85rem 1rem 0.9rem;
        font-family: ui-monospace, "SF Mono", Menlo, monospace;
        font-size: clamp(0.56rem, 0.95vw, 0.74rem);
        color: rgb(255 255 241 / 0.75);
        box-shadow: 0 30px 60px -30px rgb(0 0 0 / 0.8);
    }

    .api-head {
        display: flex;
        justify-content: space-between;
        padding-bottom: 0.6rem;
        margin-bottom: 0.5rem;
        border-bottom: 1px solid rgb(255 255 255 / 0.08);
        color: rgb(255 255 241 / 0.5);
    }

    .ok {
        color: #3ddc84;
    }

    .api-card ul {
        display: grid;
        gap: 0.4rem;
    }

    .api-card li {
        display: grid;
        grid-template-columns: 2.6rem 1fr auto auto;
        gap: 0.6rem;
        white-space: nowrap;
    }

    .path {
        overflow: hidden;
        text-overflow: ellipsis;
        color: rgb(255 255 241 / 0.9);
    }

    .method.post {
        color: #ff8a70;
    }

    .method.get {
        color: #7cc4ff;
    }

    .status {
        color: #3ddc84;
    }

    .time {
        color: rgb(255 255 241 / 0.4);
        font-variant-numeric: tabular-nums;
    }

    .api-foot {
        margin-top: 0.7rem;
        padding-top: 0.6rem;
        border-top: 1px solid rgb(255 255 255 / 0.08);
        color: #3ddc84;
    }

    .web-shot {
        display: block;
        width: 100%;
        height: auto;
        border-radius: 12px;
        border: 1px solid rgb(255 255 255 / 0.14);
        box-shadow:
            0 40px 70px -30px rgb(0 0 0 / 0.85),
            0 0 0 6px rgb(255 255 255 / 0.03);
    }

    .phone {
        display: block;
        width: 100%;
        height: auto;
        filter: drop-shadow(0 30px 30px rgb(0 0 0 / 0.6));
    }

    /* Etiqueta de cada capa. */
    .tag {
        position: absolute;
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        padding: 0.35rem 0.7rem;
        border-radius: 999px;
        background: rgb(24 24 26 / 0.92);
        border: 1px solid rgb(255 255 255 / 0.14);
        font-size: 0.75rem;
        font-weight: 600;
        white-space: nowrap;
        color: var(--color-text);
        box-shadow: 0 8px 20px -8px rgb(0 0 0 / 0.6);
        transform: translateZ(1px);
    }

    .tag i {
        width: 0.45rem;
        height: 0.45rem;
        border-radius: 50%;
        background: var(--color-primary);
    }

    .tag-web {
        top: -0.9rem;
        left: 1rem;
    }

    .tag-api {
        bottom: -0.9rem;
        left: 1rem;
    }

    .tag-mobile {
        top: 4%;
        right: 12%;
    }

    .caption {
        margin-top: 1.75rem;
        text-align: right;
        font-size: 0.8rem;
        color: rgb(255 255 241 / 0.45);
    }

    @media (max-width: 1023px) {
        .stack {
            --ry: -8deg;
        }

        .caption {
            text-align: left;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .layer {
            animation: none !important;
        }

        .stack {
            transition: none;
        }
    }
</style>

<script>
    // Inclinación leve que sigue al puntero; solo con mouse y movimiento permitido.
    function initStack() {
        const stage = document.querySelector<HTMLElement>("[data-stage]");
        const stack = document.querySelector<HTMLElement>("[data-stack]");
        if (!stage || !stack || stage.dataset.ready) return;
        stage.dataset.ready = "true";
        if (matchMedia("(prefers-reduced-motion: reduce)").matches || !matchMedia("(pointer: fine)").matches) return;

        stage.addEventListener("pointermove", (e) => {
            const r = stage.getBoundingClientRect();
            const x = (e.clientX - r.left) / r.width - 0.5;
            const y = (e.clientY - r.top) / r.height - 0.5;
            stack.style.setProperty("--ry", `${-14 + x * 8}deg`);
            stack.style.setProperty("--rx", `${6 - y * 6}deg`);
        });
        stage.addEventListener("pointerleave", () => {
            stack.style.removeProperty("--ry");
            stack.style.removeProperty("--rx");
        });
    }

    initStack();
    document.addEventListener("astro:page-load", initStack);
</script>
