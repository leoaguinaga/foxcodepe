---
import { models, modules } from "@/core/OfferData";
---

<section id="formas-de-trabajo" class="py-20 lg:py-28 max-xl:px-5 scroll-mt-28">
    <div class="w-full max-w-6xl mx-auto">
        <div class="grid gap-6 lg:grid-cols-[1fr_auto] lg:items-end">
            <h2 class="font-display text-[clamp(2.25rem,5vw,4rem)] font-semibold leading-[0.98] tracking-[-0.035em] text-balance">
                Tres formas de trabajar.
            </h2>
            <p class="max-w-md text-neutral-300">
                Empieza por el diagnóstico si aún no sabes qué necesitas. Si ya lo
                tienes claro, cotizamos el proyecto completo.
            </p>
        </div>

        <div class="mt-14 grid gap-4 lg:grid-cols-3">
            {models.map((m) => (
                <article class:list={[
                    "flex flex-col rounded-[20px] border p-7",
                    m.recommended ? "border-primary/70 bg-primary/[0.06]" : "border-white/10",
                ]}>
                    <p class:list={["text-sm", m.recommended ? "text-primary" : "text-neutral-400"]}>{m.when}</p>
                    <h3 class="mt-2 font-display text-[1.75rem] font-semibold tracking-[-0.025em]">{m.name}</h3>
                    <p class="mt-5 flex flex-wrap items-baseline gap-x-2 gap-y-1">
                        <span class="whitespace-nowrap font-display text-[1.75rem] font-semibold tracking-[-0.03em] tabular-nums">{m.price}</span>
                        <span class="text-sm text-neutral-400">{m.priceNote}</span>
                    </p>
                    <ul class="mt-6 flex flex-col gap-2.5 text-[0.95rem] text-neutral-200">
                        {m.features.map((f) => (
                            <li class="flex gap-2.5">
                                <svg class="mt-1 size-4 flex-none text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>
                                {f}
                            </li>
                        ))}
                    </ul>
                    <button
                        type="button"
                        class:list={[
                            "mt-8 rounded-full px-5 py-3 font-medium transition active:scale-[0.97]",
                            m.recommended ? "bg-primary text-white hover:bg-primary-dark" : "bg-white/5 text-white hover:bg-white/10",
                        ]}
                        aria-haspopup="dialog"
                        aria-expanded="false"
                        aria-controls="contact-us-modal"
                        data-hs-overlay="#contact-us-modal"
                    >
                        {m.id === "diagnostico" ? "Pedir diagnóstico" : m.id === "proyecto" ? "Cotizar proyecto" : "Consultar"}
                    </button>
                </article>
            ))}
        </div>

        <div class="mt-14 grid gap-6 border-t border-white/10 pt-10 lg:grid-cols-[16rem_1fr]">
            <div>
                <h3 class="font-display text-xl font-semibold tracking-[-0.02em]">Módulos frecuentes</h3>
                <p class="mt-2 text-sm text-neutral-400">Se cotizan dentro del proyecto, según lo que necesites.</p>
            </div>
            <ul class="flex flex-wrap gap-2 content-start">
                {modules.map((mod) => (
                    <li class="rounded-full border border-white/12 px-3.5 py-2 text-sm text-neutral-200">{mod}</li>
                ))}
            </ul>
        </div>
    </div>
</section>
