---
// Una sola oferta: las tres capas que construye el mismo equipo, y el
// diagnóstico como puerta de entrada.
const services = [
    { href: "/servicios#web", title: "Desarrollo web", text: "Sistemas, paneles y plataformas SaaS a la medida de tu operación." },
    { href: "/servicios#backend", title: "Backend y APIs", text: "Datos, integraciones con SUNAT y pagos, e infraestructura que escala." },
    { href: "/servicios#mobile", title: "Desarrollo móvil", text: "Apps para iOS y Android conectadas a tu mismo backend." },
    { title: "Diagnóstico técnico", text: "Alcance, arquitectura y cronograma antes de escribir código.", price: "S/850" },
];
---

<!-- Start Services Section: lista tipográfica -->
<section class="py-20 lg:py-28 max-xl:px-5">
    <div class="w-full max-w-6xl mx-auto">
        <div class="grid gap-6 lg:grid-cols-[1fr_auto] lg:items-end">
            <h2 class="font-display text-[clamp(2.25rem,5vw,4rem)] font-semibold leading-[0.98] tracking-[-0.035em]">
                Lo que hacemos.
            </h2>
            <p class="max-w-md text-neutral-300">
                Un solo equipo construye tu software completo: la web, el backend
                y la app. Sin coordinar agencias ni freelancers por separado.
            </p>
        </div>

        <ul class="services mt-14 border-b border-white/10">
            {
                services.map((s) => (
                    <li>
                        {s.href ? (
                            <a href={s.href} class="service">
                                <span class="title font-display">{s.title}</span>
                                <span class="text">{s.text}</span>
                                <svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
                            </a>
                        ) : (
                            <button
                                type="button"
                                class="service w-full text-left"
                                aria-haspopup="dialog"
                                aria-expanded="false"
                                aria-controls="contact-us-modal"
                                data-hs-overlay="#contact-us-modal"
                            >
                                <span class="title font-display">{s.title}</span>
                                <span class="text">
                                    {s.text}
                                    {s.price && <b class="price">{s.price}</b>}
                                </span>
                                <svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
                            </button>
                        )}
                    </li>
                ))
            }
        </ul>

        <p class="mt-8 text-neutral-300">
            El diseño de interfaz, las pruebas y el despliegue van incluidos en cada proyecto.
            ¿Tienes algo distinto en mente?
            <button
                type="button"
                class="text-primary underline underline-offset-4 decoration-primary/40 hover:decoration-primary transition"
                aria-haspopup="dialog"
                aria-expanded="false"
                aria-controls="contact-us-modal"
                data-hs-overlay="#contact-us-modal"
            >
                Cuéntanos tu proyecto
            </button>
            y lo vemos juntos.
        </p>
    </div>
</section>
<!-- End Services Section -->

<style>
    .service {
        --ease: cubic-bezier(0.16, 1, 0.3, 1);
        position: relative;
        isolation: isolate;
        display: grid;
        grid-template-columns: 1fr auto auto;
        align-items: center;
        gap: 1.75rem;
        padding: 1.75rem 0.25rem;
        border-top: 1px solid rgb(255 255 255 / 0.1);
        overflow: hidden;
    }

    /* Cortina naranja que se abre desde la izquierda. */
    .service::before {
        content: "";
        position: absolute;
        inset: 0;
        z-index: -1;
        background: var(--color-primary);
        clip-path: inset(0 100% 0 0);
        transition: clip-path 0.4s var(--ease);
    }

    .title {
        font-size: clamp(1.6rem, 4vw, 3.25rem);
        font-weight: 600;
        letter-spacing: -0.035em;
        line-height: 1;
        transition: transform 0.45s var(--ease);
    }

    .text {
        max-width: 32ch;
        text-align: right;
        font-size: 0.9rem;
        color: rgb(212 212 212);
        transition: color 0.2s;
    }

    .price {
        display: block;
        margin-top: 0.35rem;
        font-weight: 600;
        font-size: 1rem;
        color: var(--color-text);
        font-variant-numeric: tabular-nums;
    }

    .arrow {
        width: 1.6rem;
        height: 1.6rem;
        margin-right: 0.5rem;
        transition: transform 0.45s var(--ease);
    }

    .service:hover::before,
    .service:focus-visible::before {
        clip-path: inset(0 0 0 0);
    }

    .service:hover .title,
    .service:focus-visible .title {
        transform: translateX(1.1rem);
    }

    .service:hover .text,
    .service:focus-visible .text {
        color: rgb(255 255 255 / 0.92);
    }

    .service:hover .arrow,
    .service:focus-visible .arrow {
        transform: rotate(-45deg);
    }

    .service:focus-visible {
        outline: none;
    }

    @media (max-width: 767px) {
        .service {
            grid-template-columns: 1fr auto;
            gap: 1rem;
            padding: 1.4rem 0.25rem;
        }

        .text {
            display: none;
        }

        /* En móvil solo queda visible el precio del diagnóstico. */
        .service:has(.price) {
            grid-template-columns: 1fr auto auto;
        }

        .text:has(.price) {
            display: block;
            max-width: none;
            font-size: 0;
        }

        .text .price {
            margin-top: 0;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .service::before,
        .title,
        .arrow {
            transition-duration: 1ms;
        }
    }
</style>
