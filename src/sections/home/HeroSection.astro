---
import Logo from "@/assets/logos/logo.webp";
import LogoAyapalleck from "@/assets/logos/LogoAyapalleckMuchik.webp";
import LogoPressig from "@/assets/logos/LogoPressig.png";
import LogoAYM from "@/assets/logos/LogoAYM.svg";

const words = [
    { text: "Tu", br: false },
    { text: "idea,", br: true },
    { text: "en", br: false },
    { text: "producción.", accent: true, br: false },
];

const clients = [
    { src: LogoAyapalleck.src, alt: "Ayapalleck Muchik" },
    { src: LogoPressig.src, alt: "Pressig" },
    { src: LogoAYM.src, alt: "AYM" },
];

const bookings = [
    ["Hab. 204 · Rosa Q.", "Check-in", "Pagado"],
    ["Hab. 101 · Marco P.", "Check-out", "Pagado"],
    ["Hab. 305 · Lucía V.", "Reserva", "Adelanto"],
];
---

<!-- Start Hero Section -->
<section class="hero relative -mt-20 pt-36 pb-24 lg:pt-44 lg:pb-32 overflow-hidden max-xl:px-5">
    <div class="hero-glow" aria-hidden="true"></div>

    <div class="w-full max-w-6xl mx-auto grid lg:grid-cols-[1fr_1.12fr] gap-16 items-center">
        <!-- Copy -->
        <div>
            <h1 class="font-display text-[clamp(3.25rem,7.4vw,6.5rem)] font-semibold leading-[0.98] tracking-[-0.035em]">
                {
                    words.map((w, i) => (
                        <>
                            <span class="hero-word">
                                <span style={`--i:${i}`} class={w.accent ? "text-primary" : ""}>{w.text}</span>
                            </span>
                            {w.br ? <br /> : " "}
                        </>
                    ))
                }
            </h1>

            <p class="hero-fade hero-lead mt-7 max-w-[28rem] text-lg leading-relaxed text-neutral-300">
                Validamos, diseñamos y desarrollamos software que llega a
                producción y escala al ritmo de tu negocio.
            </p>

            <div class="hero-fade hero-ctas mt-9 flex flex-wrap gap-2.5">
                <button
                    type="button"
                    class="group inline-flex items-center gap-2 bg-primary text-white font-medium px-5 py-3 rounded-full shadow-[0_6px_20px_-6px_rgb(238_77_49/0.6)] hover:bg-primary-dark active:scale-[0.96] transition"
                    aria-haspopup="dialog"
                    aria-expanded="false"
                    aria-controls="contact-us-modal"
                    data-hs-overlay="#contact-us-modal"
                >
                    Compártenos tu idea
                    <svg class="size-4 transition-transform duration-300 group-hover:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
                </button>
                <a
                    href="/servicios"
                    class="inline-flex items-center bg-white/5 text-white font-medium px-5 py-3 rounded-full hover:bg-white/10 active:scale-[0.96] transition"
                >
                    Ver servicios
                </a>
            </div>

            <div class="hero-fade hero-proof mt-10 flex items-center gap-3 text-sm text-neutral-400">
                <span class="flex">
                    {
                        clients.map((c) => (
                            <img src={c.src} alt={c.alt} class="size-8 rounded-full border-2 border-background bg-white object-contain p-1 -ml-2 first:ml-0" loading="lazy" />
                        ))
                    }
                </span>
                Equipos en Perú que ya operan con nuestro software
            </div>
        </div>

        <!-- Stage: el boceto que compila -->
        <div class="hero-stage relative aspect-[16/11.5] max-lg:aspect-[4/4.2]" data-hero-stage aria-hidden="true">
            <svg class="hero-wire absolute inset-0 size-full overflow-visible" viewBox="0 0 640 440" preserveAspectRatio="none">
                <rect class="s" pathLength="1" x="1" y="1" width="638" height="438" rx="16" style="--d:0" />
                <line class="s" pathLength="1" x1="128" y1="1" x2="128" y2="439" style="--d:120" />
                <line class="s" pathLength="1" x1="18" y1="34" x2="96" y2="34" style="--d:160" />
                <line class="s" pathLength="1" x1="18" y1="66" x2="104" y2="66" style="--d:200" />
                <line class="s" pathLength="1" x1="18" y1="92" x2="84" y2="92" style="--d:240" />
                <line class="s" pathLength="1" x1="18" y1="118" x2="96" y2="118" style="--d:280" />
                <rect class="s" pathLength="1" x="144" y="16" width="152" height="62" rx="10" style="--d:220" />
                <rect class="s" pathLength="1" x="306" y="16" width="152" height="62" rx="10" style="--d:280" />
                <rect class="s" pathLength="1" x="468" y="16" width="156" height="62" rx="10" style="--d:340" />
                <rect class="s" pathLength="1" x="144" y="92" width="480" height="210" rx="10" style="--d:400" />
                <polyline class="s" pathLength="1" points="160,270 230,240 300,256 370,190 440,204 510,140 610,118" style="--d:500" />
                <rect class="s" pathLength="1" x="144" y="318" width="480" height="30" rx="6" style="--d:560" />
                <rect class="s" pathLength="1" x="144" y="356" width="480" height="30" rx="6" style="--d:600" />
                <rect class="s" pathLength="1" x="144" y="394" width="480" height="30" rx="6" style="--d:640" />
                <path class="trail" pathLength="1" d="M30 30 C 160 60, 260 40, 360 120 S 520 260, 600 330" />
            </svg>

            <div class="hero-ui absolute inset-0 grid lg:grid-cols-[20%_1fr] overflow-hidden rounded-2xl border border-white/15 bg-[#1c1c1f] shadow-[0_40px_80px_-30px_rgb(0_0_0/0.7)]">
                <aside class="hidden lg:flex flex-col gap-2.5 border-r border-white/10 px-3 py-4 text-[10.5px] text-white/35">
                    <span class="mb-2 flex items-center gap-1.5 text-[11px] font-semibold text-white">
                        <img src={Logo.src} alt="" class="w-3 invert" />FoxRooms
                    </span>
                    {["Inicio", "Reservas", "Huéspedes", "Calendario", "Caja"].map((item, i) => (
                        <span class={`flex items-center gap-1.5 rounded-md px-1.5 py-1 ${i === 0 ? "bg-primary/15 text-white" : ""}`}>
                            <b class="size-1.5 rounded-sm bg-current opacity-70"></b>{item}
                        </span>
                    ))}
                </aside>
                <div class="grid min-w-0 grid-rows-[auto_1fr_auto] gap-3 p-4">
                    <div class="grid grid-cols-3 gap-2.5">
                        {[["Ocupación", "87%", "+6"], ["Llegadas hoy", "34", ""], ["Ingresos", "S/ 12.4k", ""]].map(([label, value, delta]) => (
                            <div class="rounded-[10px] border border-white/10 bg-white/[0.02] px-3 py-2.5">
                                <small class="block text-[10px] text-white/60">{label}</small>
                                <b class="font-display text-[clamp(14px,1.7vw,22px)] font-semibold tabular-nums">{value}</b>
                                {delta && <em class="ml-1 text-[10px] not-italic text-emerald-400">{delta}</em>}
                            </div>
                        ))}
                    </div>
                    <div class="relative min-h-20 rounded-[10px] border border-white/10 p-2.5">
                        <small class="absolute left-3 top-2 text-[10px] text-white/60">Ocupación · 30 días</small>
                        <svg viewBox="0 0 300 100" preserveAspectRatio="none" class="block size-full">
                            <defs>
                                <linearGradient id="hero-chart-fill" x1="0" x2="0" y1="0" y2="1">
                                    <stop offset="0" stop-color="#ee4d31" stop-opacity=".35" />
                                    <stop offset="1" stop-color="#ee4d31" stop-opacity="0" />
                                </linearGradient>
                            </defs>
                            <path class="chart-area" fill="url(#hero-chart-fill)" d="M0 85 L45 70 L90 76 L140 45 L190 52 L240 22 L300 12 L300 100 L0 100Z" />
                            <path class="chart-line" pathLength="1" d="M0 85 L45 70 L90 76 L140 45 L190 52 L240 22 L300 12" />
                        </svg>
                    </div>
                    <div class="grid gap-1.5">
                        {bookings.map(([room, kind, status]) => (
                            <div class="grid grid-cols-[1fr_60px_50px] gap-2.5 rounded-md bg-white/[0.03] px-2 py-1.5 text-[10px] text-white/60">
                                <span class="truncate">{room}</span><span>{kind}</span><span class="text-emerald-400">{status}</span>
                            </div>
                        ))}
                    </div>
                </div>
            </div>

            <svg class="hero-cursor absolute left-0 top-0 z-10 size-[18px]" viewBox="0 0 18 18">
                <path d="M2 1.5 L16 8 L9 10 L6.5 16.5Z" fill="#ee4d31" stroke="#fff" stroke-width="1.2" stroke-linejoin="round" />
            </svg>

            <div class="hero-live absolute -bottom-4 right-2 lg:-right-4 z-10 flex items-center gap-2 rounded-full border border-white/15 bg-[#0d0d0e] px-4 py-2 text-[13px] font-medium shadow-[0_14px_30px_-10px_rgb(0_0_0/0.7)]">
                <span class="hero-dot size-2 rounded-full bg-emerald-400"></span>
                En producción
            </div>
        </div>
    </div>
</section>
<!-- End Hero Section -->

<style>
    /* Momento focal: el boceto que compila (~2,4 s, una vez). */
    .hero {
        --ease: cubic-bezier(0.16, 1, 0.3, 1);
    }

    .hero-glow {
        position: absolute;
        inset: -20% -10% auto auto;
        width: 70vw;
        height: 70vw;
        background: radial-gradient(closest-side, rgb(238 77 49 / 0.13), transparent 70%);
        pointer-events: none;
        z-index: -1;
        animation: hero-fade-in 1.6s ease both 1.6s;
    }

    .hero-word {
        display: inline-block;
        overflow: hidden;
        vertical-align: bottom;
        padding: 0 0.02em 0.1em;
    }

    .hero-word > span {
        display: inline-block;
        transform-origin: left bottom;
        animation: hero-rise 0.9s var(--ease) both;
        animation-delay: calc(var(--i) * 80ms + 120ms);
    }

    .hero-fade { animation: hero-fade-up 0.7s var(--ease) both; }
    .hero-lead { animation-delay: 0.55s; }
    .hero-ctas { animation-delay: 0.65s; }
    .hero-proof { animation-delay: 2.5s; }

    .hero-stage {
        transition: transform 0.5s var(--ease);
        transform-style: preserve-3d;
    }

    .hero-wire .s {
        fill: none;
        stroke: rgb(255 255 241 / 0.34);
        stroke-width: 1.2;
        stroke-dasharray: 1;
        animation: hero-draw 0.9s var(--ease) both;
        animation-delay: calc(var(--d, 0) * 1ms);
    }

    .hero-wire .trail {
        fill: none;
        stroke: var(--color-primary);
        stroke-width: 2;
        stroke-linecap: round;
        stroke-dasharray: 1;
        stroke-dashoffset: 1;
        opacity: 0;
        filter: drop-shadow(0 0 6px rgb(238 77 49 / 0.8));
        animation: hero-trail 1.3s var(--ease) 0.95s;
    }

    .hero-ui {
        animation: hero-reveal 1.25s var(--ease) both 1.05s;
    }

    .chart-line {
        fill: none;
        stroke: var(--color-primary);
        stroke-width: 2;
        stroke-dasharray: 1;
        vector-effect: non-scaling-stroke;
        animation: hero-draw 1.2s var(--ease) both 1.9s;
    }

    .chart-area { animation: hero-fade-in 1s ease both 2.4s; }

    .hero-cursor {
        opacity: 0;
        offset-path: path("M30 30 C 160 60, 260 40, 360 120 S 520 260, 600 330");
        offset-rotate: 0deg;
        animation: hero-cursor 1.3s var(--ease) 0.95s;
    }

    .hero-live { animation: hero-pop 0.55s var(--ease) both 2.3s; }

    .hero-dot {
        box-shadow: 0 0 0 0 rgb(52 211 153 / 0.6);
        animation: hero-pulse 2.2s infinite 2.9s;
    }

    @keyframes hero-rise { from { transform: translateY(108%) rotate(4deg); } }
    @keyframes hero-fade-up { from { opacity: 0; transform: translateY(10px); } }
    @keyframes hero-fade-in { from { opacity: 0; } }
    @keyframes hero-draw { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }
    @keyframes hero-trail {
        0% { stroke-dashoffset: 1; opacity: 1; }
        75% { stroke-dashoffset: 0; opacity: 1; }
        100% { stroke-dashoffset: 0; opacity: 0; }
    }
    @keyframes hero-reveal {
        from { clip-path: polygon(0 0, 0 0, 0 0, 0 0); }
        to { clip-path: polygon(0 0, 250% 0, 0 250%, 0 0); }
    }
    @keyframes hero-cursor {
        0% { opacity: 0; offset-distance: 0%; }
        10%, 85% { opacity: 1; }
        100% { opacity: 0; offset-distance: 100%; }
    }
    @keyframes hero-pop { from { opacity: 0; transform: scale(0.88) translateY(8px); } }
    @keyframes hero-pulse {
        70% { box-shadow: 0 0 0 8px rgb(52 211 153 / 0); }
        100% { box-shadow: 0 0 0 0 rgb(52 211 153 / 0); }
    }

    @media (prefers-reduced-motion: reduce) {
        .hero *, .hero-glow {
            animation-duration: 1ms !important;
            animation-delay: 0ms !important;
            animation-iteration-count: 1 !important;
        }
        .hero-cursor, .hero-wire .trail { display: none; }
    }
</style>

<script>
    // Inclinación 3D sutil siguiendo al puntero (solo puntero fino, sin reduced motion).
    function initHeroTilt() {
        const stage = document.querySelector<HTMLElement>("[data-hero-stage]");
        if (!stage || stage.dataset.tiltReady) return;
        if (!matchMedia("(pointer: fine)").matches || matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        stage.dataset.tiltReady = "true";

        stage.addEventListener("pointermove", (e) => {
            const r = stage.getBoundingClientRect();
            const x = (e.clientX - r.left) / r.width - 0.5;
            const y = (e.clientY - r.top) / r.height - 0.5;
            stage.style.transform = `perspective(1200px) rotateX(${y * -5}deg) rotateY(${x * 7}deg)`;
        });
        stage.addEventListener("pointerleave", () => (stage.style.transform = ""));
    }

    initHeroTilt();
    document.addEventListener("astro:page-load", initHeroTilt);
</script>
