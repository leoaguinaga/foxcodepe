---
import BrowserFrame from "./BrowserFrame.astro";
import RedactedUI from "./RedactedUI.astro";
import Icon from "./Icon.astro";
import type { Project } from "@/core/ProjectsData";

interface Props { example: Project }
const { example } = Astro.props;
---
<section class="pw max-xl:px-5">
    <div class="pw-grid w-full max-w-6xl mx-auto">
        <div data-reveal="up">
            <h2 class="pw-h2">Lo mejor que hemos hecho no tiene enlace.</h2>
            <p class="pw-p">
                ERPs, paneles de operación y sistemas de certificados que usan equipos enteros cada día. No podemos abrirlos al
                público, pero sí recorrerlos contigo en una llamada, con datos de prueba y sin exponer nada del cliente.
            </p>
            <div class="pw-actions">
                <button type="button" class="pj-btn pj-btn-primary" aria-haspopup="dialog" aria-expanded="false" aria-controls="contact-us-modal" data-hs-overlay="#contact-us-modal">
                    Agenda una demo guiada<Icon name="right" />
                </button>
                <a class="pj-btn pj-btn-ghost" href={`/proyectos/${example.id}`}>Ver un caso de intranet</a>
            </div>
        </div>
        {example.data.ui && (
            <BrowserFrame url="intranet · acceso restringido" data-reveal="up" data-redact style="--i:1">
                <RedactedUI ui={example.data.ui} />
            </BrowserFrame>
        )}
    </div>
</section>

<style>
    .pw { padding-block: clamp(72px, 10vw, 140px) clamp(24px, 4vw, 48px); }
    .pw-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: clamp(32px, 6vw, 88px); align-items: center; }
    .pw-h2 { font-family: var(--font-display); font-weight: 400; font-size: clamp(34px, 4.6vw, 60px); line-height: 1; letter-spacing: .01em; text-wrap: balance; }
    .pw-p { color: rgb(255 255 241 / .68); font-size: 17px; line-height: 1.6; max-width: 46ch; margin-top: 22px; }
    .pw-actions { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 32px; }
    @media (max-width: 860px) { .pw-grid { grid-template-columns: 1fr; } }
</style>

<style is:global>
    .pj-btn { display: inline-flex; align-items: center; gap: 10px; font-weight: 600; font-size: 15px; border-radius: 999px; padding: 12px 20px; border: 1px solid transparent; transition: background-color .25s, border-color .25s, color .25s; }
    .pj-btn .pi { transition: transform .3s cubic-bezier(0.16, 1, 0.3, 1); }
    .pj-btn:hover .pi { transform: translateX(3px); }
    .pj-btn:hover .pi-ne { transform: translate(2px, -2px); }
    .pj-btn-primary { background: var(--color-primary); color: #fff; }
    .pj-btn-primary:hover { background: var(--color-primary-dark); }
    .pj-btn-ghost { border-color: rgb(255 255 241 / .2); color: var(--color-text); }
    .pj-btn-ghost:hover { border-color: var(--color-text); }
    .pj-btn:focus-visible { outline: 2px solid var(--color-primary); outline-offset: 3px; }
</style>
