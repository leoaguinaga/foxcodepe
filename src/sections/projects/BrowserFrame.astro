---
import Icon from "./Icon.astro";

interface Props { url: string; class?: string; [key: string]: unknown }
const { url, class: cls = "", ...rest } = Astro.props;
---
<div class={`bframe ${cls}`} {...rest}>
    <div class="bframe-bar">
        <span class="bframe-dots" aria-hidden="true"><i></i><i></i><i></i></span>
        <span class="bframe-url"><Icon name="lock" />{url}</span>
    </div>
    <div class="bframe-body"><slot /></div>
</div>

<style is:global>
    .bframe { border-radius: clamp(12px, 1.4vw, 18px); overflow: hidden; background: #1f1f22; border: 1px solid rgb(255 255 241 / .16); box-shadow: 0 40px 80px -30px rgb(0 0 0 / .6); }
    .bframe-bar { display: flex; align-items: center; gap: 14px; padding: 11px 16px; border-bottom: 1px solid rgb(255 255 241 / .08); }
    .bframe-dots { display: flex; gap: 6px; }
    .bframe-dots i { width: 10px; height: 10px; border-radius: 50%; background: rgb(255 255 241 / .16); display: block; }
    .bframe-url { flex: 1; max-width: 420px; margin-inline: auto; display: flex; align-items: center; justify-content: center; gap: 8px; font-size: 12.5px; color: rgb(255 255 241 / .45); background: #18181a; border-radius: 8px; padding: 6px 12px; white-space: nowrap; overflow: hidden; }
    .bframe-url .pi { font-size: 12px; }
    .bframe-body { aspect-ratio: 16 / 9.4; position: relative; overflow: hidden; }
    .bframe-body > img { width: 100%; height: 100%; object-fit: cover; object-position: top left; }
</style>
