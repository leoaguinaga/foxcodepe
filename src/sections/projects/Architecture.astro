---
// Diagrama de arquitectura: cliente → API → datos, con dos servicios laterales.
// Las conexiones se dibujan al entrar en pantalla.
import type { Project } from "@/core/ProjectsData";

interface Props { arch: Project["data"]["arquitectura"] }
const { arch } = Astro.props;
const boxes = [
    { x: 10, y: 112, w: 200, d: arch.a, hl: false },
    { x: 345, y: 112, w: 210, d: arch.b, hl: true },
    { x: 690, y: 112, w: 200, d: arch.c, hl: false },
    { x: 50, y: 22, w: 200, d: arch.x, hl: false },
    { x: 50, y: 202, w: 200, d: arch.y, hl: false },
];
const wires = [
    { d: "M210 150 H345", delay: 300 },
    { d: "M555 150 H690", delay: 550 },
    { d: "M450 112 V60 H250", delay: 800 },
    { d: "M450 188 V240 H250", delay: 950 },
];
const label = `Arquitectura: ${arch.a[0]} se conecta con ${arch.b[0]}, que usa ${arch.c[0]}, ${arch.x[0]} y ${arch.y[0]}.`;
---
<div class="arch" data-reveal="up">
    <div class="arch-scroll">
        <svg viewBox="0 0 900 300" role="img" aria-label={label}>
            {wires.map((w) => <path class="arch-wire" d={w.d} pathLength="1" style={`transition-delay:${w.delay}ms`} />)}
            {boxes.map((b) => (
                <g class:list={["arch-box", { hl: b.hl }]} style={`transition-delay:${Math.round(b.x / 3)}ms`}>
                    <rect x={b.x} y={b.y} width={b.w} height="76" rx="12" />
                    <text x={b.x + 18} y={b.y + 33}>{b.d[0]}</text>
                    <text class="s" x={b.x + 18} y={b.y + 55}>{b.d[1]}</text>
                </g>
            ))}
        </svg>
    </div>
</div>

<style>
    .arch { margin-top: 40px; border: 1px solid rgb(255 255 241 / .09); border-radius: 18px; padding: clamp(16px, 3vw, 40px); background: #1f1f22; }
    .arch-scroll { overflow-x: auto; scrollbar-width: none; }
    svg { width: 100%; min-width: 620px; height: auto; display: block; overflow: visible; }
    .arch-box rect { fill: #18181a; stroke: rgb(255 255 241 / .18); stroke-width: 1.2; }
    .arch-box.hl rect { stroke: var(--color-primary); fill: color-mix(in srgb, var(--color-primary) 10%, #18181a); }
    .arch-box text { fill: var(--color-text); font-family: var(--font-body); font-size: 15px; font-weight: 600; }
    .arch-box text.s { fill: rgb(255 255 241 / .45); font-size: 12.5px; font-weight: 450; }
    .arch-wire { fill: none; stroke: var(--color-primary); stroke-width: 1.6; }
    :global(.reveal-ready) .arch-wire { stroke-dasharray: 1; stroke-dashoffset: 1; transition: stroke-dashoffset 1.1s cubic-bezier(0.16, 1, 0.3, 1); }
    :global(.reveal-ready) .arch.is-in .arch-wire { stroke-dashoffset: 0; }
    :global(.reveal-ready) .arch-box { opacity: 0; transform: translateY(8px); transition: opacity .6s cubic-bezier(0.16, 1, 0.3, 1), transform .6s cubic-bezier(0.16, 1, 0.3, 1); }
    :global(.reveal-ready) .arch.is-in .arch-box { opacity: 1; transform: none; }
</style>
