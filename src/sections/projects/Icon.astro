---
// Íconos de trazo de la página de proyectos (mismo grosor que los de la landing).
interface Props { name: "ne" | "lock" | "split" | "right" | "left" | "play"; class?: string }
const { name, class: cls = "" } = Astro.props;
const paths: Record<Props["name"], string> = {
    ne: '<path d="M7 17 17 7M8 7h9v9"/>',
    lock: '<rect x="4.5" y="10.5" width="15" height="10" rx="2.5"/><path d="M8 10.5V7.5a4 4 0 0 1 8 0v3"/>',
    split: '<rect x="4.5" y="10.5" width="9" height="9" rx="2"/><path d="M7 10.5v-2a2 2 0 0 1 4 0M14 5h5v5M19 5l-6 6"/>',
    right: '<path d="M5 12h14M13 6l6 6-6 6"/>',
    left: '<path d="M19 12H5M11 6l-6 6 6 6"/>',
    play: '<circle cx="12" cy="12" r="8.5"/><path d="m10.5 9 4.5 3-4.5 3z"/>',
};
---
<svg class={`pi ${name === "ne" ? "pi-ne" : ""} ${cls}`} viewBox="0 0 24 24" aria-hidden="true" set:html={paths[name]} />

<style is:global>
    .pi { width: 1em; height: 1em; flex: none; stroke: currentColor; fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
</style>
