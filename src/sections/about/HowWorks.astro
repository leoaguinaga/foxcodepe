---
import ProcessStepCard from "@/components/ProcessStepCard.astro";
import { processData } from "@/core/ProcessSteepData"; 
---

<section class="py-20 max-xl:px-5">
    <div class="space-y-10 w-full max-w-5xl text-center mx-auto">
        <h3
            data-reveal="up"
            class="text-3xl lg:text-4xl font-medium text-white max-w-3xl mx-auto"
        >
            Cómo transformamos tu <span class="text-primary ink">idea</span> en realidad
        </h3>

        <!-- Steeps -->
        <div class="relative grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5" data-reveal-group>
            <!-- Línea que une los pasos y se dibuja al entrar -->
            <div aria-hidden="true" class="steps-line max-lg:hidden absolute top-11 inset-x-10 h-px bg-white/10 overflow-hidden"><span class="block h-full bg-primary"></span></div>
            {processData.map((step, index) => (
                <ProcessStepCard 
                    icon={step.icon}
                    title={step.title}
                    description={step.description}
                    number={index + 1}
                    index={index}
                />
            ))}
        </div>
    </div>
</section>
