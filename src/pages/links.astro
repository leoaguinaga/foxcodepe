---
import Logo from "@/assets/logos/logo-full-white.webp";
import Instagram from "@/assets/icons/instagram.svg";
import Tiktok from "@/assets/icons/tiktok.svg";
import { siteSeo } from "@/core/SeoData";
import "@/styles/global.css";

// Página "link in bio": va en la bio de Instagram/TikTok, así que no lleva
// navbar ni footer del sitio; todo cabe en una columna de teléfono.

const whatsappMessage = encodeURIComponent(
    "Hola FoxCode, vengo de su página de links y quiero conversar sobre un proyecto.",
);
const whatsappUrl = `https://wa.me/${siteSeo.phone.replace("+", "")}?text=${whatsappMessage}`;

const products = [
    {
        name: "FoxRooms",
        description:
            "Gestión hotelera: reservas, check-in, caja y canales OTA en un solo panel.",
        href: "https://rooms.foxcodepe.com",
        domain: "rooms.foxcodepe.com",
        icon: "/links/foxrooms.png",
    },
    {
        name: "En La Mesa",
        description:
            "Carta digital para restaurantes: tu menú en línea, con QR y siempre actualizado.",
        href: "https://enlamesa.pe",
        domain: "enlamesa.pe",
        icon: "/links/enlamesa.png",
    },
];

const socials = [
    {
        name: "Instagram",
        handle: "@foxcode.pe",
        href: "https://www.instagram.com/foxcode.pe/",
        icon: "instagram",
    },
    {
        name: "TikTok",
        handle: "@foxcode.pe",
        href: "https://www.tiktok.com/@foxcode.pe",
        icon: "tiktok",
    },
    {
        name: "LinkedIn",
        handle: "FoxCode",
        href: "https://www.linkedin.com/company/foxcodepe",
        icon: "linkedin",
    },
];

const more = [
    {
        label: "Agenda una reunión",
        detail: "30 minutos para aterrizar tu idea",
        href: "/#agendar",
        icon: "calendar",
    },
    {
        label: "Nuestro sitio web",
        detail: "foxcodepe.com",
        href: "/",
        icon: "globe",
    },
    {
        label: "Escríbenos un correo",
        detail: siteSeo.email,
        href: `mailto:${siteSeo.email}`,
        icon: "mail",
    },
];

const title = "Links | FoxCode";
const description =
    "WhatsApp, redes y productos de FoxCode: FoxRooms y En La Mesa.";
const canonicalUrl = new URL(
    "/links",
    Astro.site ?? "https://foxcode.pe",
).toString();
---

<!doctype html>
<html lang={siteSeo.language}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link
            rel="icon"
            type="image/webp"
            href="/favicon-dark.webp"
            media="(prefers-color-scheme: light)"
        />
        <link
            rel="icon"
            type="image/webp"
            href="/favicon-light.webp"
            media="(prefers-color-scheme: dark)"
        />
        <meta name="description" content={description} />
        <meta name="theme-color" content="#18181a" />
        <link rel="canonical" href={canonicalUrl} />
        <meta property="og:site_name" content={siteSeo.name} />
        <meta property="og:type" content="website" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonicalUrl} />
        <meta
            property="og:image"
            content={new URL("/og.png", canonicalUrl).toString()}
        />
        <meta property="og:locale" content={siteSeo.locale} />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&display=swap"
            rel="stylesheet"
        />
        <title>{title}</title>
    </head>

    <body class="bg-background text-text min-h-dvh antialiased">
        <!-- Halo de marca detrás del encabezado -->
        <div
            aria-hidden="true"
            class="pointer-events-none fixed inset-x-0 top-0 h-80 bg-[radial-gradient(60%_100%_at_50%_0%,color-mix(in_srgb,var(--color-primary)_22%,transparent),transparent)]"
        >
        </div>

        <main
            class="relative mx-auto flex w-full max-w-md flex-col gap-y-8 px-4 pt-12 pb-10"
        >
            <header class="links-rise flex flex-col items-center text-center">
                <img
                    src={Logo.src}
                    alt="FoxCode"
                    class="h-11 w-auto"
                    width={Logo.width}
                    height={Logo.height}
                />
                <p class="mt-4 max-w-xs text-sm text-pretty text-white/60">
                    Software a medida, apps y productos digitales para negocios
                    que quieren crecer.
                </p>
            </header>

            <!-- Acción principal -->
            <a
                href={whatsappUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="links-rise group flex items-center gap-x-3 rounded-2xl bg-primary px-5 py-4 font-semibold text-white shadow-[0_12px_40px_-12px_var(--color-primary)] transition-[background-color,transform] duration-200 hover:bg-primary-dark active:scale-[0.98] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary"
                style="--d: 1"
            >
                <svg
                    class="size-6 shrink-0"
                    fill="currentColor"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                >
                    <path
                        d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"
                    ></path>
                </svg>
                <span class="flex-1">
                    Escríbenos por WhatsApp
                    <span class="block text-xs font-normal text-white/80"
                        >Respondemos en menos de 24 horas</span
                    >
                </span>
                <svg
                    class="size-5 shrink-0 transition-transform duration-200 group-hover:translate-x-0.5"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                    ><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"
                    ></path></svg
                >
            </a>

            <!-- Productos activos -->
            <section
                class="links-rise flex flex-col gap-y-3"
                style="--d: 2"
                aria-labelledby="links-productos"
            >
                <h2
                    id="links-productos"
                    class="px-1 text-xs font-semibold tracking-widest text-white/50 uppercase"
                >
                    Nuestros productos
                </h2>
                {
                    products.map((product) => (
                        <a
                            href={product.href}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="group flex items-center gap-x-4 rounded-2xl border border-white/10 bg-white/[0.04] p-3 pr-4 transition-colors duration-200 hover:border-white/20 hover:bg-white/[0.07] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
                        >
                            <img
                                src={product.icon}
                                alt=""
                                class="size-14 shrink-0 rounded-xl"
                                width="56"
                                height="56"
                                loading="lazy"
                            />
                            <span class="min-w-0 flex-1">
                                <span class="flex items-center gap-x-2">
                                    <span class="font-display text-lg leading-tight font-semibold">
                                        {product.name}
                                    </span>
                                </span>
                                <span class="mt-0.5 block text-sm leading-snug text-pretty text-white/60">
                                    {product.description}
                                </span>
                                <span class="mt-1 block text-xs text-white/40 group-hover:text-primary">
                                    {product.domain} ↗
                                </span>
                            </span>
                        </a>
                    ))
                }
            </section>

            <!-- Redes -->
            <section
                class="links-rise flex flex-col gap-y-3"
                style="--d: 3"
                aria-labelledby="links-redes"
            >
                <h2
                    id="links-redes"
                    class="px-1 text-xs font-semibold tracking-widest text-white/50 uppercase"
                >
                    Síguenos
                </h2>
                <div class="grid grid-cols-3 gap-2">
                    {
                        socials.map((social) => (
                            <a
                                href={social.href}
                                target="_blank"
                                rel="noopener noreferrer"
                                aria-label={`${social.name} de FoxCode (${social.handle})`}
                                class="flex flex-col items-center gap-y-2 rounded-2xl border border-white/10 bg-white/[0.04] px-2 py-4 transition-colors duration-200 hover:border-white/20 hover:bg-white/[0.07] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
                            >
                                <span class="grid size-7 place-items-center">
                                    {social.icon === "instagram" && (
                                        <Instagram
                                            class="size-8 fill-white"
                                            aria-hidden="true"
                                        />
                                    )}
                                    {social.icon === "tiktok" && (
                                        <Tiktok
                                            class="size-6 fill-white"
                                            aria-hidden="true"
                                        />
                                    )}
                                    {social.icon === "linkedin" && (
                                        <svg
                                            class="size-[22px] text-white"
                                            viewBox="0 0 24 24"
                                            fill="currentColor"
                                            aria-hidden="true"
                                        >
                                            <path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z" />
                                        </svg>
                                    )}
                                </span>
                                <span class="text-xs text-white/70">
                                    {social.name}
                                </span>
                            </a>
                        ))
                    }
                </div>
            </section>

            <!-- Más -->
            <section
                class="links-rise flex flex-col gap-y-3"
                style="--d: 4"
                aria-labelledby="links-mas"
            >
                <h2
                    id="links-mas"
                    class="px-1 text-xs font-semibold tracking-widest text-white/50 uppercase"
                >
                    Más de FoxCode
                </h2>
                <ul
                    class="divide-y divide-white/10 overflow-hidden rounded-2xl border border-white/10 bg-white/[0.04]"
                >
                    {
                        more.map((item) => (
                            <li>
                                <a
                                    href={item.href}
                                    class="group flex items-center gap-x-3 px-4 py-3.5 transition-colors duration-200 hover:bg-white/[0.05] focus-visible:bg-white/[0.07] focus-visible:outline-none"
                                >
                                    <span class="grid size-9 shrink-0 place-items-center rounded-lg bg-white/[0.06] text-white/80">
                                        <svg
                                            class="size-[18px]"
                                            viewBox="0 0 24 24"
                                            fill="none"
                                            stroke="currentColor"
                                            stroke-width="2"
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            aria-hidden="true"
                                        >
                                            {item.icon === "calendar" && (
                                                <>
                                                    <path d="M8 2v4" />
                                                    <path d="M16 2v4" />
                                                    <rect
                                                        width="18"
                                                        height="18"
                                                        x="3"
                                                        y="4"
                                                        rx="2"
                                                    />
                                                    <path d="M3 10h18" />
                                                </>
                                            )}
                                            {item.icon === "globe" && (
                                                <>
                                                    <circle
                                                        cx="12"
                                                        cy="12"
                                                        r="10"
                                                    />
                                                    <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20" />
                                                    <path d="M2 12h20" />
                                                </>
                                            )}
                                            {item.icon === "mail" && (
                                                <>
                                                    <rect
                                                        x="2"
                                                        y="4"
                                                        width="20"
                                                        height="16"
                                                        rx="2"
                                                    />
                                                    <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
                                                </>
                                            )}
                                        </svg>
                                    </span>
                                    <span class="min-w-0 flex-1">
                                        <span class="block text-sm font-medium">
                                            {item.label}
                                        </span>
                                        <span class="block truncate text-xs text-white/50">
                                            {item.detail}
                                        </span>
                                    </span>
                                    <svg
                                        class="size-4 shrink-0 text-white/30 transition-transform duration-200 group-hover:translate-x-0.5 group-hover:text-white/70"
                                        viewBox="0 0 24 24"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="2"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        aria-hidden="true"
                                    >
                                        <path d="m9 18 6-6-6-6" />
                                    </svg>
                                </a>
                            </li>
                        ))
                    }
                </ul>
            </section>

            <footer class="pt-2 text-center text-xs text-white/40">
                © {new Date().getFullYear()} FoxCode · Hecho en Perú
            </footer>
        </main>

        <style>
            .links-rise {
                animation: links-rise 600ms cubic-bezier(0.16, 1, 0.3, 1) both;
                animation-delay: calc(var(--d, 0) * 70ms);
            }

            @keyframes links-rise {
                from {
                    opacity: 0;
                    transform: translateY(12px);
                }
            }

            @media (prefers-reduced-motion: reduce) {
                .links-rise {
                    animation: none;
                }
            }
        </style>
    </body>
</html>
