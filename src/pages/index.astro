---
import Layout from "@/layouts/Layout.astro";
import HeroSection from "@/sections/home/HeroSection.astro";
import StatsLine from "@/sections/home/StatsLine.astro";
import ProcessSection from "@/sections/home/ProcessSection.astro";
import Products from "@/sections/home/Products.astro";
import Services from "@/sections/home/Services.astro";
import Schedule from "@/sections/home/Schedule.astro";
import { seoPages } from "@/core/SeoData";
---

<Layout {...seoPages.home}>

    <div class="flex flex-col md:gap-y-10">
        <HeroSection />
        <ProcessSection />
        <StatsLine />
        <Products />
        <Services />
        <div id="agendar">
            <Schedule />
        </div>
    </div>

</Layout>
