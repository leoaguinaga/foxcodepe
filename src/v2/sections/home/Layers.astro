---
import { layers, included } from "@/v2/core/OfferData";

// Corte de un sistema real (FoxRooms + integraciones) para mostrar que las tres
// capas son una sola pieza construida por el mismo equipo.
const integrations = ["SUNAT", "Mercado Pago", "DNI / RUC"];
---

<section class="py-20 lg:py-28 max-xl:px-5">
    <div class="w-full max-w-6xl mx-auto">
        <div class="grid gap-14 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
            <div>
                <h2 class="font-display text-[clamp(2.25rem,5vw,4rem)] font-semibold leading-[0.98] tracking-[-0.035em] text-balance">
                    Web, backend y mobile.<br /><span class="text-primary">Un solo equipo.</span>
                </h2>
                <p class="mt-6 max-w-[34rem] text-lg leading-relaxed text-neutral-300">
                    No tienes que coordinar una agencia de diseño, un freelancer de backend
                    y otro de apps. Las mismas personas construyen cada capa, de principio a fin.
                </p>
                <p class="mt-8 text-sm text-neutral-400">Incluido en cada proyecto</p>
                <ul class="mt-3 flex flex-wrap gap-2">
                    {included.map((item) => (
                        <li class="rounded-full border border-white/12 px-3 py-1.5 text-sm text-neutral-200">{item}</li>
                    ))}
                </ul>
            </div>

            <!-- Diagrama del sistema -->
            <figure class="system" aria-label="Diagrama: app móvil y panel web conectados a una API, base de datos e integraciones, construidos por el mismo equipo">
                <div class="tier tier-clients">
                    <div class="node">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="7" y="2.5" width="10" height="19" rx="2.5" /><path d="M11 18.5h2" /></svg>
                        <b>App móvil</b><small>iOS · Android</small>
                    </div>
                    <div class="node">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2.5" y="4" width="19" height="13" rx="2" /><path d="M8 20.5h8M12 17v3.5" /></svg>
                        <b>Panel web</b><small>Recepción · Caja</small>
                    </div>
                </div>
                <div class="wires" aria-hidden="true">
                    <svg viewBox="0 0 200 40" preserveAspectRatio="none"><path d="M50 0 V16 Q50 22 56 22 H94 Q100 22 100 28 V40 M150 0 V16 Q150 22 144 22 H106 Q100 22 100 28" /></svg>
                </div>
                <div class="tier">
                    <div class="node node-core">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m8 7-5 5 5 5M16 7l5 5-5 5" /></svg>
                        <b>API</b><small>Reglas de negocio · Roles · Auditoría</small>
                    </div>
                </div>
                <div class="wires" aria-hidden="true">
                    <svg viewBox="0 0 200 40" preserveAspectRatio="none"><path d="M100 0 V12 Q100 18 94 18 H56 Q50 18 50 24 V40 M100 12 Q100 18 106 18 H144 Q150 18 150 24 V40" /></svg>
                </div>
                <div class="tier tier-clients">
                    <div class="node">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><ellipse cx="12" cy="5.5" rx="7.5" ry="3" /><path d="M4.5 5.5v13c0 1.7 3.4 3 7.5 3s7.5-1.3 7.5-3v-13M4.5 12c0 1.7 3.4 3 7.5 3s7.5-1.3 7.5-3" /></svg>
                        <b>Base de datos</b><small>PostgreSQL · Backups</small>
                    </div>
                    <div class="node">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 7H6a4 4 0 0 0 0 8h3M15 7h3a4 4 0 0 1 0 8h-3M8 11h8" /></svg>
                        <b>Integraciones</b><small>{integrations.join(" · ")}</small>
                    </div>
                </div>
                <figcaption class="bracket">
                    <span>FoxCode</span>
                </figcaption>
            </figure>
        </div>

        <ul class="layers mt-20 border-b border-white/10">
            {layers.map((layer) => (
                <li>
                    <a href={`/v2/servicios#${layer.id}`} class="layer">
                        <span class="tag">{layer.tag}</span>
                        <span class="title font-display">{layer.name}</span>
                        <span class="text">{layer.summary}</span>
                        <svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
                    </a>
                </li>
            ))}
        </ul>
    </div>
</section>

<style>
    .system {
        --ease: cubic-bezier(0.16, 1, 0.3, 1);
        position: relative;
        margin: 0;
        padding: 1.5rem 3.25rem 1.5rem 1.5rem;
        border: 1px solid rgb(255 255 255 / 0.1);
        border-radius: 20px;
        background:
            radial-gradient(120% 80% at 100% 0%, rgb(238 77 49 / 0.1), transparent 60%),
            #1c1c1f;
    }

    .tier {
        display: grid;
        gap: 0.75rem;
    }

    .tier-clients {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .node {
        display: grid;
        grid-template-columns: auto 1fr;
        grid-template-rows: auto auto;
        column-gap: 0.75rem;
        align-items: center;
        padding: 0.85rem 1rem;
        border: 1px solid rgb(255 255 255 / 0.1);
        border-radius: 12px;
        background: rgb(255 255 255 / 0.02);
        min-width: 0;
    }

    .node svg {
        grid-row: span 2;
        width: 1.35rem;
        height: 1.35rem;
        fill: none;
        stroke: rgb(255 255 241 / 0.7);
        stroke-width: 1.6;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    .node b {
        font-family: var(--font-display);
        font-weight: 600;
        font-size: 1rem;
        letter-spacing: 0.01em;
    }

    .node small {
        font-size: 0.78rem;
        color: rgb(255 255 241 / 0.55);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .node-core {
        border-color: rgb(238 77 49 / 0.55);
        background: rgb(238 77 49 / 0.08);
    }

    .node-core svg {
        stroke: var(--color-primary);
    }

    .wires svg {
        display: block;
        width: 100%;
        height: 2.25rem;
        fill: none;
        stroke: rgb(255 255 241 / 0.22);
        stroke-width: 1.2;
        vector-effect: non-scaling-stroke;
        stroke-dasharray: 4 4;
        animation: flow 1.6s linear infinite;
    }

    @keyframes flow {
        to { stroke-dashoffset: -16; }
    }

    /* La llave une todas las capas: un solo responsable. */
    .bracket {
        position: absolute;
        top: 1.5rem;
        bottom: 1.5rem;
        right: 1rem;
        width: 1.25rem;
        border: 1.5px solid var(--color-primary);
        border-left: 0;
        border-radius: 0 10px 10px 0;
    }

    .bracket span {
        position: absolute;
        top: 50%;
        left: 100%;
        transform: translate(-50%, -50%) rotate(90deg);
        transform-origin: center;
        margin-left: 0.6rem;
        padding: 0 0.4rem;
        background: #1c1c1f;
        font-family: var(--font-display);
        font-size: 0.8rem;
        font-weight: 600;
        letter-spacing: 0.02em;
        color: var(--color-primary);
        white-space: nowrap;
    }

    /* Filas de capas: misma cortina naranja que la lista de servicios actual. */
    .layer {
        --ease: cubic-bezier(0.16, 1, 0.3, 1);
        position: relative;
        isolation: isolate;
        display: grid;
        grid-template-columns: 6.5rem 1fr auto auto;
        align-items: center;
        gap: 1.75rem;
        padding: 1.75rem 0.25rem;
        border-top: 1px solid rgb(255 255 255 / 0.1);
        overflow: hidden;
    }

    .layer::before {
        content: "";
        position: absolute;
        inset: 0;
        z-index: -1;
        background: var(--color-primary);
        clip-path: inset(0 100% 0 0);
        transition: clip-path 0.4s var(--ease);
    }

    .tag {
        font-family: ui-monospace, "SF Mono", Menlo, monospace;
        font-size: 0.78rem;
        color: rgb(255 255 241 / 0.5);
        transition: color 0.2s;
    }

    .title {
        font-size: clamp(1.6rem, 4vw, 3.25rem);
        font-weight: 600;
        letter-spacing: -0.035em;
        line-height: 1;
        transition: transform 0.45s var(--ease);
    }

    .text {
        max-width: 34ch;
        text-align: right;
        font-size: 0.9rem;
        color: rgb(212 212 212);
        transition: color 0.2s;
    }

    .arrow {
        width: 1.6rem;
        height: 1.6rem;
        margin-right: 0.5rem;
        transition: transform 0.45s var(--ease);
    }

    .layer:hover::before,
    .layer:focus-visible::before {
        clip-path: inset(0 0 0 0);
    }

    .layer:hover .title,
    .layer:focus-visible .title {
        transform: translateX(1.1rem);
    }

    .layer:hover .text,
    .layer:focus-visible .text,
    .layer:hover .tag,
    .layer:focus-visible .tag {
        color: rgb(255 255 255 / 0.92);
    }

    .layer:hover .arrow,
    .layer:focus-visible .arrow {
        transform: rotate(-45deg);
    }

    .layer:focus-visible {
        outline: none;
    }

    @media (max-width: 767px) {
        .layer {
            grid-template-columns: 1fr auto;
            gap: 0.35rem 1rem;
            padding: 1.4rem 0.25rem;
        }

        .tag {
            grid-column: 1 / -1;
        }

        .text {
            display: none;
        }
    }

    @media (max-width: 480px) {
        .system {
            padding: 1rem 2.75rem 1rem 1rem;
        }

        .tier-clients {
            gap: 0.5rem;
        }

        .node {
            grid-template-columns: 1fr;
            padding: 0.75rem;
        }

        .node svg {
            grid-row: auto;
            margin-bottom: 0.4rem;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .wires svg {
            animation: none;
        }

        .layer::before,
        .title,
        .arrow {
            transition-duration: 1ms;
        }
    }
</style>
