---
const index = [
    { href: "#web", label: "Web" },
    { href: "#backend", label: "Backend y APIs" },
    { href: "#mobile", label: "Mobile" },
    { href: "#como-trabajamos", label: "Cómo trabajamos" },
    { href: "#formas-de-trabajo", label: "Formas de trabajo" },
    { href: "#preguntas", label: "Preguntas" },
];
---

<section class="relative -mt-20 pt-36 pb-16 lg:pt-44 lg:pb-20 overflow-hidden max-xl:px-5">
    <div class="w-full max-w-6xl mx-auto">
        <h1 class="font-display text-[clamp(2.75rem,6.6vw,5.75rem)] font-semibold leading-[0.98] tracking-[-0.035em] text-balance max-w-[14ch]">
            Tu software completo, hecho por <span class="text-primary">un solo equipo.</span>
        </h1>
        <div class="mt-8 grid gap-8 lg:grid-cols-[1fr_auto] lg:items-end">
            <p class="max-w-[36rem] text-lg leading-relaxed text-neutral-300">
                Diseñamos, programamos y desplegamos la web, el backend y la app.
                Una persona responsable de tu proyecto y entregas cada semana en un
                staging que puedes usar.
            </p>
            <div class="flex flex-wrap gap-2.5">
                <a href="#formas-de-trabajo" class="inline-flex items-center gap-2 bg-primary text-white font-medium px-5 py-3 rounded-full shadow-[0_6px_20px_-6px_rgb(238_77_49/0.6)] hover:bg-primary-dark active:scale-[0.96] transition">
                    Ver formas de trabajo
                </a>
                <a href="/v2#agendar" class="inline-flex items-center bg-white/5 text-white font-medium px-5 py-3 rounded-full hover:bg-white/10 active:scale-[0.96] transition">
                    Agendar diagnóstico
                </a>
            </div>
        </div>

        <nav aria-label="Secciones de la página" class="mt-14 flex gap-2 overflow-x-auto pb-1 [scrollbar-width:none]">
            {index.map((item) => (
                <a href={item.href} class="shrink-0 rounded-full border border-white/12 px-4 py-2 text-sm text-neutral-300 hover:border-white/30 hover:text-white transition-colors">
                    {item.label}
                </a>
            ))}
        </nav>
    </div>
</section>

<script is:inline>
    // Enlaces viejos de /servicios: el hash no llega al servidor, se traduce aquí.
    (function () {
        var map = {
            "#desarrollo-software": "#web",
            "#desarrollo-movil": "#mobile",
            "#diseno-ui-ux": "#como-trabajamos",
            "#consultoria-tech": "#como-trabajamos",
            "#branding": "",
        };
        var next = map[location.hash];
        if (next === undefined) return;
        history.replaceState(null, "", location.pathname + next);
        if (next) addEventListener("DOMContentLoaded", function () {
            var el = document.querySelector(next);
            if (el) el.scrollIntoView();
        });
    })();
</script>
