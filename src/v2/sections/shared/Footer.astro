---
import Logo from "@/assets/logos/logo-full-white.webp";
import Instagram from "@/assets/icons/instagram.svg";
import Tiktok from "@/assets/icons/tiktok.svg";
import { ownProducts } from "@/v2/core/OfferData";
---

<!-- Footer Section -->
<section class="w-full py-5 max-xl:px-5">
    <footer class="w-full max-w-6xl mx-auto">
        <!-- Links and social media -->
        <div
            class="grid sm:grid-cols-3 md:grid-cols-4 gap-y-10 gap-x-5 md:gap-x-10"
        >
            <article
                class="text-sm flex flex-col gap-y-3 sm:col-span-3 md:col-span-1 mx-auto md:mx-0"
            >
                <img
                    src={Logo.src}
                    class="object-contain h-10 mr-auto"
                    alt="FoxCode Logo"
                />
                <div class="flex items-center max-md:justify-center gap-x-3">
                    <a
                        href="https://www.instagram.com/foxcode.pe/"
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label="Instagram de FoxCode"
                        ><Instagram
                            class="size-7 fill-white sm:size-8 hover:opacity-80 transition-opacity"
                        /></a
                    >
                    <a
                        href="https://www.tiktok.com/@foxcode.pe"
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label="TikTok de FoxCode"
                        ><Tiktok
                            class="size-5 fill-white sm:size-6 hover:opacity-80 transition-opacity"
                        /></a
                    >
                    <a
                        href="https://www.linkedin.com/company/foxcodepe"
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label="LinkedIn de FoxCode"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 24 24"
                            class="size-5 fill-white sm:size-6 hover:opacity-80 transition-opacity"
                            aria-hidden="true"
                        >
                            <path
                                d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.125 2.062 2.062 0 0 1 0 4.125zM7.119 20.452H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
                            ></path>
                        </svg>
                    </a>
                </div>
            </article>

            <article class="text-sm flex flex-col max-sm:items-center gap-y-3">
                <h3 class="font-semibold uppercase tracking-widest mb-3">
                    Empresa
                </h3>
                <a
                    href="/v2"
                    class="text-white/60 hover:text-white hover:underline w-fit"
                    >Inicio</a
                >
                <a
                    href="/v2/servicios"
                    class="text-white/60 hover:text-white hover:underline w-fit"
                    >Desarrollo</a
                >
                <a
                    href="/v2/nosotros"
                    class="text-white/60 hover:text-white hover:underline w-fit"
                    >Nosotros</a
                >
            </article>

            <article class="text-sm flex flex-col max-sm:items-center gap-y-3">
                <h3 class="font-semibold uppercase tracking-widest mb-3">
                    Trabajo
                </h3>

                {
                    ownProducts.map((product) => (
                        <a
                            href={`/v2/trabajo#${product.id}`}
                            class="text-white/60 hover:text-white hover:underline w-fit"
                        >
                            {product.name}
                        </a>
                    ))
                }
            </article>

            <article class="text-sm flex flex-col max-sm:items-center gap-y-3">
                <h3 class="font-semibold uppercase tracking-widest mb-3">
                    Contáctanos
                </h3>
                <a
                    href="mailto:contacto@foxcode.com"
                    class="flex items-center gap-x-2 text-white/60 hover:text-white hover:underline w-fit"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="24"
                        height="24"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="lucide lucide-mail-icon lucide-mail size-4"
                        ><path d="m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7"
                        ></path><rect x="2" y="4" width="20" height="16" rx="2"
                        ></rect></svg
                    >
                    contacto&#8203;@foxcode.com
                </a>
                <a
                    href="tel:+51907280391"
                    class="flex items-center gap-x-2 text-white/60 hover:text-white hover:underline w-fit"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="24"
                        height="24"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="lucide lucide-phone-icon lucide-phone size-4"
                        ><path
                            d="M13.832 16.568a1 1 0 0 0 1.213-.303l.355-.465A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2A18 18 0 0 1 2 4a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3a2 2 0 0 1-.8 1.6l-.468.351a1 1 0 0 0-.292 1.233 14 14 0 0 0 6.392 6.384"
                        ></path></svg
                    >
                    +51 907 280 391
                </a>
                <a
                    href="https://wa.me/51907280391"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex items-center gap-x-2 text-white/60 hover:text-white hover:underline w-fit"
                >
                    <svg
                        class="w-4 h-4"
                        fill="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z" />
                    </svg>
                    +51 907 280 391
                </a>
            </article>
        </div>

        <!-- Copyright Message, Terms & Privacy Policy -->
        <div
            class="flex flex-wrap justify-center items-center gap-x-3 gap-y-2 mt-20 text-xs sm:text-sm"
        >
            <p class="text-center text-white/60">
                &copy; {new Date().getFullYear()} Foxcode.
            </p>

            <div class="rounded-full size-1 bg-white/60"></div>
            <a
                href="/legal#terms"
                class="text-white/60 hover:underline hover:text-white text-nowrap"
                >Términos y Condiciones.</a
            >
            <div class="rounded-full size-1 bg-white/60"></div>
            <a
                href="/legal#privacity"
                class="text-white/60 hover:underline hover:text-white text-nowrap"
                >Política de privacidad.</a
            >
            <div class="rounded-full size-1 bg-white/60"></div>
            <a
                href="/legal#reclamations"
                class="text-white/60 hover:underline hover:text-white text-nowrap"
                >Libro de reclamaciones.</a
            >

        </div>
    </footer>
</section>
