---
import { Image } from "astro:assets";
import { ownProducts, layers } from "@/v2/core/OfferData";
import { productMockups, productTransitionName } from "@/core/ProductMockups";
import LogoEnLaMesa from "@/assets/images/product-logos/enlamesa.png";
import LogoContralio from "@/assets/images/product-logos/contralio.svg";
import FoxRoomsDashboard from "@/assets/images/modules/foxrooms/dashboard.png";
import FoxRoomsBooking from "@/assets/images/modules/foxrooms/booking.png";
import FoxRoomsCheckIn from "@/assets/images/modules/foxrooms/check-in.png";

const layerName = Object.fromEntries(layers.map((l) => [l.id, l.name]));

const visuals: Record<string, { tint: string; logo?: ImageMetadata; shots?: { src: ImageMetadata; alt: string }[] }> = {
    foxrooms: {
        tint: "#ee4d31",
        shots: [
            { src: FoxRoomsDashboard, alt: "Panel de control de FoxRooms" },
            { src: FoxRoomsBooking, alt: "Calendario de reservas de FoxRooms" },
            { src: FoxRoomsCheckIn, alt: "Check-in de FoxRooms" },
        ],
    },
    enlamesa: { tint: "#ff6b4a", logo: LogoEnLaMesa },
    contralio: { tint: "#2554eb", logo: LogoContralio },
};
---

<section class="py-12 lg:py-16 max-xl:px-5" aria-labelledby="own-products-title">
    <div class="w-full max-w-6xl mx-auto">
        <h2 id="own-products-title" class="font-display text-[clamp(1.75rem,3.4vw,2.5rem)] font-semibold tracking-[-0.03em]">
            Productos propios
        </h2>
        <p class="mt-3 max-w-xl text-neutral-300">
            Los construimos, los mantenemos y los usamos con clientes reales. Son la
            mejor muestra de cómo trabajaríamos en tu proyecto.
        </p>

        <div class="mt-12 border-b border-white/10">
            {ownProducts.map((p) => {
                const v = visuals[p.id];
                return (
                    <article id={p.id} class="grid gap-10 border-t border-white/10 py-14 lg:grid-cols-[1fr_1.1fr] lg:items-center scroll-mt-28" style={`--tint:${v.tint}`}>
                        <div>
                            <h3 class="font-display text-[clamp(2.25rem,4.6vw,3.75rem)] font-semibold leading-[0.98] tracking-[-0.035em]">{p.name}</h3>
                            <p class="mt-5 max-w-[30rem] text-lg leading-relaxed text-neutral-300">{p.text}</p>
                            <p class="mt-6 text-sm text-neutral-500">Capas</p>
                            <ul class="mt-2 flex flex-wrap gap-2">
                                {p.layers.map((id) => (
                                    <li class="rounded-full border border-white/12 px-3 py-1.5 text-sm text-neutral-200">{layerName[id]}</li>
                                ))}
                            </ul>
                            {p.href && (
                                <a href={p.href} target="_blank" rel="noopener" class="mt-8 inline-flex items-center gap-2 text-white hover:text-primary transition-colors">
                                    Visitar {p.href.replace("https://", "")}
                                    <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9" /></svg>
                                </a>
                            )}
                        </div>

                        <div class="visual relative overflow-hidden rounded-[20px] border border-white/10 bg-[#1c1c1f]">
                            {v.shots ? (
                                <div class="grid grid-cols-[0.8fr_1.2fr] items-end gap-4 p-6 sm:p-8">
                                    <Image
                                        src={productMockups[p.id]}
                                        alt={`${p.name} en un teléfono`}
                                        width={420}
                                        class="relative h-auto w-full"
                                        style={`view-transition-name:${productTransitionName(p.id)}`}
                                        loading="lazy"
                                    />
                                    <div class="relative flex flex-col gap-3">
                                        {v.shots.map((s) => (
                                            <Image src={s.src} alt={s.alt} width={640} class="h-auto w-full rounded-lg border border-white/10" loading="lazy" />
                                        ))}
                                    </div>
                                </div>
                            ) : (
                                <div class="grid aspect-[16/10] place-items-center">
                                    <Image src={v.logo!} alt={`Logo de ${p.name}`} width={240} class="relative h-auto w-[22%] min-w-20 rounded-[22%]" loading="lazy" />
                                </div>
                            )}
                        </div>
                    </article>
                );
            })}
        </div>
    </div>
</section>

<style>
    .visual::before {
        content: "";
        position: absolute;
        inset: auto -20% -45% -20%;
        height: 80%;
        background: radial-gradient(closest-side, color-mix(in srgb, var(--tint) 45%, transparent), transparent);
        filter: blur(20px);
        opacity: 0.55;
        pointer-events: none;
    }
</style>
