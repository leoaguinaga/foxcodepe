---
import LogoPressig from "@/assets/logos/LogoPressig.png";
import LogoAyapalleck from "@/assets/logos/LogoAyapalleckMuchik.webp";
import LogoAYM from "@/assets/logos/LogoAYM.svg";

// Testimonios existentes, ahora ligados al proyecto que se construyó.
const clients = [
    {
        client: "Pressig",
        project: "Certifox · emisión y validación de certificados",
        quote: "Con Certifox digitalizamos la emisión y validación de certificados de forma rápida y segura. FoxCode entendió nuestro proceso y lo convirtió en una solución clara.",
        author: "Fernando Pérez, CEO de Pressig",
        logo: LogoPressig,
    },
    {
        client: "Hotel Ayapalleck Muchik",
        project: "FoxRooms · reservas, habitaciones y caja",
        quote: "Foxrooms nos ayudó a organizar reservas, habitaciones y atención diaria. Ahora gestionamos Ayapalleck Muchik con más orden y mejor experiencia para los huéspedes.",
        author: "Maria Flores, dueña del Hotel Ayapalleck Muchik",
        logo: LogoAyapalleck,
    },
    {
        client: "Corporación AYM",
        project: "Sistema a medida para su operación",
        quote: "FoxCode diseñó e implementó una solución alineada a nuestras operaciones. El equipo fue cercano, propositivo y enfocado en resolver necesidades reales del negocio.",
        author: "José Acedo, dueño de Corporación AYM",
        logo: LogoAYM,
    },
];
---

<section class="py-20 lg:py-28 max-xl:px-5" aria-labelledby="client-work-title">
    <div class="w-full max-w-6xl mx-auto">
        <h2 id="client-work-title" class="font-display text-[clamp(1.75rem,3.4vw,2.5rem)] font-semibold tracking-[-0.03em]">
            Proyectos para clientes
        </h2>
        <p class="mt-3 max-w-xl text-neutral-300">Empresas en Perú que operan con software que construimos para ellas.</p>

        <div class="mt-12 grid gap-px overflow-hidden rounded-[20px] border border-white/10 bg-white/10 lg:grid-cols-3">
            {clients.map((c) => (
                <figure class="m-0 flex flex-col bg-background p-7">
                    <div class="flex items-center gap-3">
                        <span class="grid size-11 flex-none place-items-center rounded-full bg-white p-1.5">
                            <img src={c.logo.src} alt="" class="max-h-full max-w-full object-contain" loading="lazy" />
                        </span>
                        <div class="min-w-0">
                            <p class="font-display text-lg font-semibold tracking-[-0.015em]">{c.client}</p>
                            <p class="text-sm text-neutral-400">{c.project}</p>
                        </div>
                    </div>
                    <blockquote class="mt-6 text-[1.02rem] leading-relaxed text-neutral-100">“{c.quote}”</blockquote>
                    <figcaption class="mt-auto pt-6 text-sm text-neutral-500">{c.author}</figcaption>
                </figure>
            ))}
        </div>
    </div>
</section>
